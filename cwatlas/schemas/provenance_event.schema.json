{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provenance Event",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "source_class",
    "raw_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "source_class": {
      "type": "string"
    },
    "raw_hash": {
      "type": "string"
    },
    "operator_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "software_commit": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}