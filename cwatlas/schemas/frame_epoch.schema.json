{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frame and Epoch Certificate",
  "type": "object",
  "required": [
    "body_id",
    "frame_id",
    "epoch",
    "time_scale",
    "orientation_profile_id"
  ],
  "properties": {
    "body_id": {
      "type": "string"
    },
    "frame_id": {
      "type": "string"
    },
    "epoch": {
      "type": "string"
    },
    "time_scale": {
      "type": "string"
    },
    "orientation_profile_id": {
      "type": "string"
    },
    "ephemeris_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "hash": {
      "type": "string"
    }
  }
}