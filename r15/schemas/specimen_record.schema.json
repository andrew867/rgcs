{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "specimen_id",
    "material",
    "mass",
    "geometry",
    "orientation",
    "provenance"
  ],
  "properties": {
    "specimen_id": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "mass": {
      "type": "object"
    },
    "geometry": {
      "type": "object"
    },
    "orientation": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "defects": {
      "type": "array"
    },
    "photos": {
      "type": "array"
    },
    "status": {
      "type": "string"
    }
  }
}
