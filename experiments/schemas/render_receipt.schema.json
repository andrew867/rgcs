{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rgcs://schemas/render_receipt.schema.json",
  "title": "Frequency Key Studio render receipt",
  "type": "object",
  "required": ["receipt_id", "session_id", "sample_rate", "duration_s",
               "outputs", "input_sha256", "output_sha256"],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "sample_rate": {"type": "integer", "minimum": 8000},
    "duration_s": {"type": "number", "exclusiveMinimum": 0},
    "peak": {"type": "number", "minimum": 0},
    "rms": {"type": "number", "minimum": 0},
    "normalized": {"type": "boolean"},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "kind": {"type": "string"}
        }
      }
    },
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "software": {"type": "object"},
    "generated_utc": {"type": "string"}
  }
}
