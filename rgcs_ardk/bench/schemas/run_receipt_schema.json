{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rgcs.example/schemas/r1074/run_receipt.schema.json",
  "title": "RGCS-ARDK-001 Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "timestamp_utc",
    "operator",
    "config_hash",
    "code_commit",
    "primary_observable",
    "instrument_calibration_ids",
    "raw_data_hashes",
    "uncertainty",
    "controls",
    "angle_tracks",
    "magnitude_beats_nulls",
    "transforms_pass",
    "artifacts_bounded",
    "claim_language",
    "verdict"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "operator": {"type": "string", "minLength": 1},
    "config_hash": {"$ref": "#/$defs/hash"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "waveform_hash": {"$ref": "#/$defs/hash"},
    "randomization_seed": {"type": "integer"},
    "primary_observable": {"const": "DeltaB"},
    "instrument_calibration_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "raw_data_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hash"}
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["angular_deg", "amplitude_norm"],
      "properties": {
        "angular_deg": {"type": "number", "exclusiveMinimum": 0},
        "amplitude_norm": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "controls": {
      "type": "object",
      "required": [
        "all_active",
        "binary_best",
        "equal_resource_randomized",
        "reversed_lag",
        "rotated",
        "mirrored",
        "dummy_load"
      ],
      "properties": {
        "all_active": {"$ref": "#/$defs/control"},
        "binary_best": {"$ref": "#/$defs/control"},
        "equal_resource_randomized": {"$ref": "#/$defs/control"},
        "reversed_lag": {"$ref": "#/$defs/control"},
        "rotated": {"$ref": "#/$defs/control"},
        "mirrored": {"$ref": "#/$defs/control"},
        "dummy_load": {"$ref": "#/$defs/control"},
        "no_crystal": {"$ref": "#/$defs/control"},
        "dummy_crystal": {"$ref": "#/$defs/control"}
      },
      "additionalProperties": false
    },
    "crystal_lane_included": {"type": "boolean", "default": false},
    "angle_tracks": {"type": "boolean"},
    "magnitude_beats_nulls": {"type": "boolean"},
    "transforms_pass": {"type": "boolean"},
    "artifacts_bounded": {"type": "boolean"},
    "claim_language": {
      "const": "CONTROLLED_FIELD_ASYMMETRY_OBSERVED_WITHIN_THIS_BUDGET"
    },
    "verdict": {
      "enum": ["PASS_FIELD_ASYMMETRY", "FAIL_FIELD_ASYMMETRY"]
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "control": {
      "oneOf": [
        {"type": "boolean"},
        {
          "type": "object",
          "required": ["receipt_hash"],
          "properties": {"receipt_hash": {"$ref": "#/$defs/hash"}},
          "additionalProperties": true
        }
      ]
    }
  }
}
